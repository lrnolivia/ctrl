{
  "name": "ctrl",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CTRL_ENABLED": "true"
  },
  "services": [
    {
      "binding": "RELAY",
      "service": "relay"
    }
  ],
  "routes": [
    {
      "pattern": "ctrl.loew.fi",
      "custom_domain": true
    }
  ]
}
